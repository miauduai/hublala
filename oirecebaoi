-- ============================================
-- WYZIN HUB | SERVER HOP + WHITELIST
-- ============================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ============================================
-- WHITELIST POR NICK
-- ============================================

local WHITELIST = {
    ["KAUANxxx826"] = true,
    ["wattskaren"] = true,
}

local autorizado = WHITELIST[LocalPlayer.Name]

if not autorizado then
    LocalPlayer:Kick("Você não tem autorização para usar isso!")
    return
end

-- ============================================
-- EXECUTAR SCRIPT ORIGINAL
-- ============================================

loadstring(game:HttpGet(
    "https://rawscripts.net/raw/Universal-Script-Universal-server-hop-script-130449"
))()

-- ============================================
-- SERVIÇOS
-- ============================================

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local finalizados = {}
local connections = {}

-- ============================================
-- CORES
-- ============================================

local ROXO_ESCURO = Color3.fromRGB(35, 15, 50)
local ROXO = Color3.fromRGB(75, 30, 105)
local ROXO_CLARO = Color3.fromRGB(110, 55, 145)
local BRANCO = Color3.fromRGB(255, 255, 255)

-- ============================================
-- APLICAR TEMA
-- ============================================

local function aplicarTema(obj)

    pcall(function()

        if obj:IsA("Frame") then
            obj.BackgroundColor3 = ROXO_ESCURO

        elseif obj:IsA("ScrollingFrame") then
            obj.BackgroundColor3 = ROXO_ESCURO

        elseif obj:IsA("TextButton") then
            obj.BackgroundColor3 = ROXO
            obj.TextColor3 = BRANCO

        elseif obj:IsA("TextLabel") then
            obj.TextColor3 = BRANCO

        elseif obj:IsA("TextBox") then
            obj.BackgroundColor3 = ROXO_ESCURO
            obj.TextColor3 = BRANCO

        end

    end)

end

-- ============================================
-- ALTERAR TÍTULO
-- ============================================

local function alterarTitulo(obj)

    if finalizados[obj] then
        return
    end

    if not (
        obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
    ) then
        return
    end

    local texto = obj.Text

    if type(texto) ~= "string" then
        return
    end

    if string.find(
        texto,
        "SERVER BROWSER & DIAGNOSTICS",
        1,
        true
    ) then

        obj.Text = "WYZIN HUB | SERVER HOP"
        finalizados[obj] = true

    end

end

-- ============================================
-- PROCESSAR OBJETO
-- ============================================

local function processar(obj)

    aplicarTema(obj)
    alterarTitulo(obj)

    if (
        obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
    ) then

        if not connections[obj] then

            connections[obj] =
                obj:GetPropertyChangedSignal("Text"):Connect(function()

                    if not finalizados[obj] then
                        task.defer(function()
                            alterarTitulo(obj)
                        end)
                    end

                end)

        end

    end

end

-- ============================================
-- UI EXISTENTE
-- ============================================

for _, obj in ipairs(PlayerGui:GetDescendants()) do
    processar(obj)
end

-- ============================================
-- UI CRIADA DEPOIS
-- ============================================

PlayerGui.DescendantAdded:Connect(function(obj)

    task.defer(function()

        if obj and obj.Parent then
            processar(obj)
        end

    end)

end)
